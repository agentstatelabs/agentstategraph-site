<!-- Get started -->
<section class="section" id="start">
  <div class="container">
    <p class="kicker" data-reveal>Get started</p>
    <h2 class="title" data-reveal>Connect an agent in 60 seconds</h2>
    <p class="subtitle" data-reveal>One binary is the MCP server, the HTTP API, and the migration CLI. Point an agent at it and start recording.</p>
    <div data-reveal>
      <div class="terminal">
        <div class="term-bar"><div class="tdot r"></div><div class="tdot y"></div><div class="tdot g"></div><span class="term-title">agentstategraph — zsh</span></div>
        <pre class="term-body" id="term"></pre>
      </div>
    </div>
    <div style="text-align:center;margin-top:26px" data-reveal>
